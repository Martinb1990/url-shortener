#!/bin/sh
# {{ ansible_managed }}
# server-baseline closes the INPUT policy. Pods and service IPs must still
# reach the node (API server, DNS, kubelet), and pod traffic must be
# forwarded, so allow the cluster CIDRs. Idempotent: rules are only added
# when missing. Runs before every k3s start and every minute from
# k3s-netguard.timer (a host firewall reload removes them otherwise).
set -eu
for cidr in {{ k3s_pod_cidr }} {{ k3s_service_cidr }}; do
  iptables -C INPUT -s "$cidr" -j ACCEPT 2>/dev/null || iptables -I INPUT 1 -s "$cidr" -j ACCEPT
done
for dir in -s -d; do
  iptables -C FORWARD "$dir" {{ k3s_pod_cidr }} -j ACCEPT 2>/dev/null || iptables -I FORWARD 1 "$dir" {{ k3s_pod_cidr }} -j ACCEPT
done
